{
  "name": "opencv-studio",
  "version": "1.2.0",
  "description": "Herramienta de escritorio para crear currículums profesionales 100% libre y sin suscripciones",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . \"OpenCV Studio\" --platform=win32 --arch=x64 --out=dist --overwrite --prune=true --ignore=\"^/(dist|\\.git)\""
  },
  "keywords": [
    "cv",
    "curriculum",
    "resume",
    "builder",
    "ats",
    "offline",
    "free"
  ],
  "author": "César Alberto López Martínez & OpenCV Studio",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-packager": "^17.1.2"
  }
}
